# Browser-safe (RLS protects data). Publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY – never prefix with NEXT_PUBLIC_, never import from client components.
# Used only by scripts / future admin-provisioning server code. Not needed by the app yet.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant (Google Gemini; server-only, never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Required, no default: a Gemini model ID your key can use (https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# Optional cost/limit controls
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=100
AI_TIMEOUT_MS=45000
# Optional: your model's USD price per million tokens, to show an estimated cost in Settings
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Public origin used in auth email links, e.g. http://localhost:3000 (must be in Supabase redirect allow-list)
NEXT_PUBLIC_SITE_URL=
