# Browser-safe (RLS protects data). Publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the deployed app (used in password-reset / verification links), e.g. https://task-manager-pmf.vercel.app
NEXT_PUBLIC_SITE_URL=

# Timezone for "today" (optional, default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
